rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Profil masing-masing user
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Kehadiran (online/typing) - siapa saja yg login bisa tulis dokumennya sendiri
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Invite code: siapa saja yg login boleh baca (buat join) & hapus (setelah dipakai)
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow delete: if signedIn();
    }

    // Couple & semua subkoleksinya (chat, album, letters, call) -> hanya 2 member
    function isCoupleMember(coupleId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    match /couples/{coupleId} {
      // buat couple baru: creator harus memasukkan dirinya sendiri sbg member
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members;
      allow read, update, delete: if isCoupleMember(coupleId);

      match /{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }
  }
}
