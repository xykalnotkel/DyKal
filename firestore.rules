rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Hanya anggota couple yang boleh akses
    function isMember(coupleId) {
      let doc = get(/databases/$(database)/documents/couples/$(coupleId));
      return signedIn() && doc.exists && request.auth.uid in doc.data.members;
    }

    // Profil user — LONGGAR di fase auth/register (permintaan owner):
    // siapa pun yang LOGIN boleh baca profil SATU user by id (dia harus tahu
    // uid-nya), tapi TIDAK bisa dump semua user (list dilarang).
    // Tulis: tetap hanya diri sendiri.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Presence (online / typing / last seen) — sama: baca by id longgar,
    // list dilarang, tulis hanya milik sendiri.
    match /presence/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Invite code pairing
    // FIX #1: user ke-2 (pasangan) HARUS bisa baca kode SEBELUM join.
    // Rules lama menolak karena dia belum member -> permission-denied di
    // joinWithCode(). Kode itu sendiri rahasianya (acak, 24 jam, sekali pakai),
    // jadi 'get' (baca SATU dok by id) aman untuk semua user yang login.
    // 'list' (query semua kode) tetap dilarang biar kode orang tidak bisa di-dump.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isMember(resource.data.coupleId)
      );
    }

    // Metadata Couple — hanya anggota
    match /couples/{coupleId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;

      // FIX #2 (v1.1.5): saat joinWithCode(), pasangan membaca doc couple SEBELUM
      // jadi member -> rules lama menolak. Dan yg lebih halus: kalau doc couple
      // TIDAK ADA (coupleId usang setengah jadi), akses resource.data error ->
      // Firestore balas PERMISSION_DENIED & AuthGate nyangkut. Sekarang:
      // doc tidak ada = diizinkan (Firestore balas NOT_FOUND -> app route ke Pairing).
      allow get: if isMember(coupleId) || (
        signedIn() && (resource == null || resource.data.members.size() < 2)
      );
      allow list: if false;

      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (request.auth.uid in request.resource.data.members && request.resource.data.members.size() <= 2)
      );
      allow delete: if isMember(coupleId);

      // Subkoleksi (albums, photos, letters)
      match /{document=**} {
        allow read, write: if isMember(coupleId);
      }
    }

    // Pesan Chat — hanya anggota couple
    match /chats/{coupleId} {
      allow read, write: if isMember(coupleId);
      match /{document=**} {
        allow read, write: if isMember(coupleId);
      }
    }

    // Signaling WebRTC Panggilan — hanya anggota couple
    match /calls/{coupleId} {
      allow read, write: if isMember(coupleId);
      match /{document=**} {
        allow read, write: if isMember(coupleId);
      }
    }

    // Info update aplikasi (dibaca UpdateService.checkForUpdate di semua device)
    // FIX #3: koleksi ini sebelumnya TIDAK ADA di rules -> selalu permission-denied.
    // Isinya cuma info versi + link APK (tidak sensitif), jadi baca bebas;
    // tulis cuma dari Firebase Console.
    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
