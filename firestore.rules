rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Cek apakah user login adalah salah satu member couple
    function isMember(coupleId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // === Profil user ===
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // === Status online/typing (presence) ===
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // === Invite code pairing ===
    match /inviteCodes/{code} {
      allow read, create, delete: if signedIn();
    }

    // === Couple (metadata) ===
    match /couples/{coupleId} {
      // Bikin couple baru: creator wajib memasukkan dirinya ke members
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      // Baca metadata: siapa saja yang login (pasangan kedua butuh ini SEBELUM jadi member)
      allow read: if signedIn();
      // Update: member boleh; ATAU orang join (nambah diri) selama total member <= 2
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (request.auth.uid in request.resource.data.members && request.resource.data.members.size() <= 2)
      );
      allow delete: if isMember(coupleId);

      // SEMUA subkoleksi couple (album, letters) -> KUNCI hanya member
      match /{document=**} {
        allow read, write: if isMember(coupleId);
      }
    }

    // === Chat (koleksi top-level chats/{coupleId}/messages) ===
    match /chats/{coupleId} {
      allow read, write: if isMember(coupleId);
      match /{document=**} {
        allow read, write: if isMember(coupleId);
      }
    }

    // === Signaling panggilan (koleksi top-level calls/{coupleId}) ===
    match /calls/{coupleId} {
      allow read, write: if isMember(coupleId);
      match /{document=**} {
        allow read, write: if isMember(coupleId);
      }
    }
  }
}
